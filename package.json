{
  "name": "deck-mentor",
  "version": "0.4.0",
  "description": "Ask Claude for game walkthrough help on Steam Deck, with screenshots, save analysis and a hotkey",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "pnpm run build && python3 scripts/package.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "claude"
  ],
  "author": "FPSarmin",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "1.4.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
